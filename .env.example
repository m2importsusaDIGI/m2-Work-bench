# xAI grok-4.5 key, used server-side only (src/lib/engine.server.ts, src/lib/visibility.server.ts).
# Never expose this as a VITE_ prefixed variable — it must stay off the client bundle.
XAI_API_KEY=

# No key needed for the CRM's "Find prospects" search — it runs on free, keyless
# OpenStreetMap services (Nominatim + Overpass), see src/lib/prospect.server.ts.

# SEO audit engine (Audit page). Optional Google API key so PageSpeed Insights
# doesn't hit the anonymous quota. The engine itself needs no key.
PSI_API_KEY=
# Only needed when running outside Docker, e.g. on Windows:
# SEO_ENGINE_PYTHON=python
# CLAUDE_SEO_SCRIPTS=C:\path\to\claude-seo\scripts
